stand_residuals <- function(f_obs, f_exp, row_total, grand_total, col_total){
stand_residuals <- (f_obs-f_exp)/sqrt(f_exp*(1-(row_total/grand_total))*(1-(col_total/grand_total)))
return(stand_residuals)
}
