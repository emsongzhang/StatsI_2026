calculate_median <- function(a) {
a <- sort(a)
n <- length(a)
m <- (n + 1) %/% 2
if (n %% 2 == 1) {
med <- a[m]
} else {
browser()
med <- mean(a[m:m+1])
}
return(med)
}
browser()
